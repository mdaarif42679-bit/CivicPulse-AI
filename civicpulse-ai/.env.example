# Copy this file to .env (in the project root) and edit.

# true  = Demo Mode: no external services, deterministic fallback AI (default)
# false = use the real Gemini API (requires GEMINI_API_KEY)
DEMO_MODE=false

# Get a key at https://aistudio.google.com/apikey  (never commit it, never put it in client code)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
PORT=5050
# Combined similarity score (0-1) needed to group a report into an existing issue.
# Defaults: 0.55 in Demo Mode, 0.74 with Gemini embeddings.
SIMILARITY_THRESHOLD=
